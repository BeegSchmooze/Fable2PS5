+#include <rex/thread.h>
+#include <atomic>
+#include <cstdint>
+
+namespace rex::thread {
+
+uint32_t current_thread_system_id() {
+    static std::atomic<uint32_t> nextId{1};
+
+    thread_local const uint32_t id =
+        nextId.fetch_add(1, std::memory_order_relaxed);
+
+    return id;
+}
