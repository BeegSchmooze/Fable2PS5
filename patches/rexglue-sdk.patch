+    constexpr uint64_t size = Ps5GuestArena::kSize;
+    constexpr uint64_t unit = Ps5GuestArena::kUnit;
+
+    if (offset >= size || bytes > size - offset)
+        return false;
+
+    const uint64_t first = offset & ~(unit - 1);
+    const uint64_t last =
+        (offset + bytes - 1) & ~(unit - 1);
+
+    for (uint64_t page = first; page <= last; page += unit) {
+        bool ok = false;
+
+        if (page < 0x7F000000ULL) {
+            ok = ps5_arena_->mapVirtual(uint32_t(page));
+        } else if (page < 0x80000000ULL) {
+            ok = ps5_arena_->mapPhysical(
