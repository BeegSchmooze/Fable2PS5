+++ b/include/rex/platform/ps5_guest_arena.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <ps5platform/shm.h>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace rex::memory {
+
+class Ps5GuestArena {
+public:
+    static constexpr size_t kUnit = 0x10000;
+    static constexpr size_t kSize = 0x120000000ULL;
+
+    ~Ps5GuestArena();
+
+    bool initialize();
+    bool mapVirtual(uint32_t guest_offset);
+    bool mapPhysical(uint32_t offset);
+    bool mapXex(uint32_t offset);
+    bool unmapPhysical(uint32_t offset);
+    bool unmapXex(uint32_t offset);
+    bool shutdown();
+
+    uint8_t* address(uint64_t guestAddress) const;
+
+private:
+    struct Unit {
+        uint32_t offset = 0;
+        bool xex = false;
+        bool virtual_mem = false;
+        ps5_shm backing{};
+        std::array<void*, 5> views{};
+    };
+
+    void* base_ = nullptr;
+    std::vector<Unit> units_;
+
+    bool mapUnit(uint32_t offset, bool xex);
+    bool unmapUnit(uint32_t offset, bool xex);
+    static bool releaseUnit(Unit& unit);
+};
+
+}
diff --git a/src/core/clock_ps5.cpp b/src/core/clock_ps5.cpp
new file mode 100644
index 0000000..41f7f23
--- /dev/null
+++ b/src/core/clock_ps5.cpp
@@ -0,0 +1,41 @@
+#include <rex/chrono/clock.h>
+#include <ps5platform/kernel.h>
+#include <sys/time.h>
+#include <cstdint>
+
+namespace rex::chrono {
+
+uint64_t Clock::host_tick_frequency_platform() {
+    return sceKernelGetTscFrequency();
+}
+
+uint64_t Clock::host_tick_count_platform() {
+    return sceKernelReadTsc();
+}
+
+uint64_t Clock::QueryHostSystemTime() {
+    timeval now{};
+    if (gettimeofday(&now, nullptr) != 0)
+        return 0;
+
+    // Convert Unix time to Windows FILETIME:
+    // 100-nanosecond intervals since January 1, 1601.
+    constexpr uint64_t epochOffset = 11644473600ULL;
+
+    return (static_cast<uint64_t>(now.tv_sec) + epochOffset)
+               * 10000000ULL
+           + static_cast<uint64_t>(now.tv_usec) * 10ULL;
+}
+
+uint64_t Clock::QueryHostUptimeMillis() {
+    const uint64_t frequency = host_tick_frequency_platform();
+    if (!frequency)
+        return 0;
+
+    const uint64_t ticks = host_tick_count_platform();
+
+    return static_cast<uint64_t>(
+        static_cast<__uint128_t>(ticks) * 1000 / frequency);
+}
+
+} // namespace rex::chrono
diff --git a/src/core/exception_handler_ps5.cpp b/src/core/exception_handler_ps5.cpp
new file mode 100644
index 0000000..c306e62
--- /dev/null
+++ b/src/core/exception_handler_ps5.cpp
@@ -0,0 +1,200 @@
+#include <rex/exception_handler.h>
+#include <rex/platform.h>
+#include <ps5platform/context.h>
+
+#include <signal.h>
+#include <ucontext.h>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+static_assert(REX_PLATFORM_PS5, "PS5 backend only");
+
+namespace rex::arch {
+
+namespace {
+
+constexpr size_t kMaxHandlers = 8;
+std::pair<ExceptionHandler::Handler, void*> handlers[kMaxHandlers]{};
+
+struct sigaction oldSegv{};
+struct sigaction oldBus{};
+struct sigaction oldIll{};
+bool installed = false;
+
+const struct sigaction* previousAction(int signal) {
+    switch (signal) {
+    case SIGSEGV: return &oldSegv;
+    case SIGBUS:  return &oldBus;
+    case SIGILL:  return &oldIll;
+    default:      return nullptr;
+    }
+}
+
+void handleSignal(int signal, siginfo_t* info, void* opaque) {
+    if (!opaque || !info)
+        std::_Exit(128 + signal);
+
+    auto& mc = reinterpret_cast<ucontext_t*>(opaque)->uc_mcontext;
+
+    // x86-64 register order required by ReXGlue.
+    using Reg = decltype(mc.mc_rax);
+    Reg* regs[16] = {
+        &mc.mc_rax, &mc.mc_rcx, &mc.mc_rdx, &mc.mc_rbx,
+        &mc.mc_rsp, &mc.mc_rbp, &mc.mc_rsi, &mc.mc_rdi,
+        &mc.mc_r8,  &mc.mc_r9,  &mc.mc_r10, &mc.mc_r11,
+        &mc.mc_r12, &mc.mc_r13, &mc.mc_r14, &mc.mc_r15
+    };
+
+    HostThreadContext ctx{};
+    ctx.rip = static_cast<uint64_t>(mc.mc_rip);
+    ctx.eflags = static_cast<uint32_t>(mc.mc_rflags);
+
+    for (unsigned i = 0; i < 16; ++i)
+        ctx.int_registers[i] = static_cast<uint64_t>(*regs[i]);
+
+    // FreeBSD x86-64 uses a 512-byte FXSAVE area.
+    // Its XMM0-XMM15 registers begin at byte offset 160.
+    const bool hasXmm =
+        mc.mc_fpformat == _MC_FPFMT_XMM &&
+        mc.mc_ownedfp != _MC_FPOWNED_NONE;
+
+    constexpr size_t kXmmOffset = 160;
+    static_assert(sizeof(mc.mc_fpstate) >=
+                  kXmmOffset + sizeof(ctx.xmm_registers));
+
+    if (hasXmm) {
+        std::memcpy(ctx.xmm_registers,
+                    reinterpret_cast<const uint8_t*>(mc.mc_fpstate)
+                        + kXmmOffset,
+                    sizeof(ctx.xmm_registers));
+    }
+
+    Exception ex;
+
+    if (signal == SIGILL) {
+        ex.InitializeIllegalInstruction(&ctx);
+    } else {
+        const auto operation =
+            (static_cast<uint64_t>(mc.mc_err) & 2)
+            ? Exception::AccessViolationOperation::kWrite
+            : Exception::AccessViolationOperation::kRead;
+
+        ex.InitializeAccessViolation(
+            &ctx,
+            reinterpret_cast<uint64_t>(info->si_addr),
+            operation);
+    }
+
+    for (const auto& entry : handlers) {
+        if (!entry.first)
+            break;
+
+        if (!entry.first(&ex, entry.second))
+            continue;
+
+        // Write modified CPU state back to the signal context.
+        mc.mc_rip = static_cast<Reg>(ctx.rip);
+        mc.mc_rflags = static_cast<Reg>(ctx.eflags);
+
+        const uint16_t changed = ex.modified_int_registers();
+
+        for (unsigned i = 0; i < 16; ++i) {
+            if (changed & (uint16_t(1) << i))
+                *regs[i] = static_cast<Reg>(ctx.int_registers[i]);
+        }
+
+        const uint16_t changedXmm = ex.modified_xmm_registers();
+
+        if (changedXmm && !hasXmm)
+            std::_Exit(128 + signal);
+
+        auto* fp = reinterpret_cast<uint8_t*>(mc.mc_fpstate);
+
+        for (unsigned i = 0; i < 16; ++i) {
+            if (changedXmm & (uint16_t(1) << i)) {
+                std::memcpy(fp + kXmmOffset + i * 16,
+                            &ctx.xmm_registers[i], 16);
+            }
+        }
+
+        return;
+    }
+
+    // Never silently retry an unhandled fault forever.
+    if (const auto* previous = previousAction(signal)) {
+        sigaction(signal, previous, nullptr);
+        raise(signal);
+    }
+    std::_Exit(128 + signal);
+}
+
+} // namespace
+
+void ExceptionHandler::Install(Handler fn, void* data) {
+    if (!fn)
+        std::abort();
+
+    size_t slot = kMaxHandlers;
+    for (size_t i = 0; i < kMaxHandlers; ++i) {
+        if (!handlers[i].first) {
+            slot = i;
+            break;
+        }
+    }
+
+    if (slot == kMaxHandlers)
+        std::abort();
+
+    if (!installed) {
+        struct sigaction action{};
+        action.sa_sigaction = handleSignal;
+        action.sa_flags = SA_SIGINFO;
+        sigemptyset(&action.sa_mask);
+
+        if (sigaction(SIGSEGV, &action, &oldSegv) != 0)
+            std::abort();
+
+        if (sigaction(SIGBUS, &action, &oldBus) != 0) {
+            sigaction(SIGSEGV, &oldSegv, nullptr);
+            std::abort();
+        }
+
+        if (sigaction(SIGILL, &action, &oldIll) != 0) {
+            sigaction(SIGBUS, &oldBus, nullptr);
+            sigaction(SIGSEGV, &oldSegv, nullptr);
+            std::abort();
+        }
+
+        installed = true;
+    }
+
+    handlers[slot] = {fn, data};
+}
+
+void ExceptionHandler::Uninstall(Handler fn, void* data) {
+    for (size_t i = 0; i < kMaxHandlers; ++i) {
+        if (handlers[i].first == fn &&
+            handlers[i].second == data) {
+            for (size_t j = i; j + 1 < kMaxHandlers; ++j)
+                handlers[j] = handlers[j + 1];
+
+            handlers[kMaxHandlers - 1] = {};
+            break;
+        }
+    }
+
+    bool active = false;
+    for (const auto& entry : handlers)
+        active |= entry.first != nullptr;
+
+    if (!active && installed) {
+        sigaction(SIGILL, &oldIll, nullptr);
+        sigaction(SIGBUS, &oldBus, nullptr);
+        sigaction(SIGSEGV, &oldSegv, nullptr);
+        installed = false;
+    }
+}
+
+} // namespace rex::arch
diff --git a/src/core/memory_ps5.cpp b/src/core/memory_ps5.cpp
new file mode 100644
index 0000000..1c55a3d
--- /dev/null
+++ b/src/core/memory_ps5.cpp
@@ -0,0 +1,77 @@
+#include <rex/memory/utils.h>
+#include <ps5platform/kernel.h>
+#include <cstdint>
+
+namespace rex::memory {
+
+size_t page_size() {
+    return PS5_KERNEL_PAGE_SIZE;
+}
+
+size_t allocation_granularity() {
+    return PS5_KERNEL_DIRECT_ALIGNMENT;
+}
+
+static int ps5Protection(PageAccess access) {
+    switch (access) {
+    case PageAccess::kNoAccess: return 0;
+    case PageAccess::kReadOnly: return PS5_KERNEL_PROT_CPU_READ;
+    case PageAccess::kReadWrite: return PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE;
+    case PageAccess::kExecuteReadOnly: return PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_EXEC;
+    case PageAccess::kExecuteReadWrite: return PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE | PS5_KERNEL_PROT_CPU_EXEC;
+    }
+    return 0;
+}
+
+static PageAccess rexProtection(uint32_t flags) {
+    bool read = flags & PS5_KERNEL_PROT_CPU_READ;
+    bool write = flags & PS5_KERNEL_PROT_CPU_WRITE;
+    bool exec = flags & PS5_KERNEL_PROT_CPU_EXEC;
+
+    if (exec) return write ? PageAccess::kExecuteReadWrite : PageAccess::kExecuteReadOnly;
+    if (write) return PageAccess::kReadWrite;
+    if (read) return PageAccess::kReadOnly;
+    return PageAccess::kNoAccess;
+}
+
+bool QueryProtect(void* address, size_t& length, PageAccess& access) {
+    void *start = nullptr, *end = nullptr;
+    uint32_t flags = 0;
+
+    if (!address || sceKernelQueryMemoryProtection(
+            address, &start, &end, &flags) != 0)
+        return false;
+
+    if ((uintptr_t)end <= (uintptr_t)start)
+        return false;
+
+    length = (uintptr_t)end - (uintptr_t)start;
+    access = rexProtection(flags);
+    return true;
+}
+
+bool Protect(void* address, size_t length, PageAccess access,
+             PageAccess* old_access) {
+    if (!address || !length)
+        return false;
+
+    if (old_access) {
+        size_t old_length = 0;
+        if (!QueryProtect(address, old_length, *old_access))
+            return false;
+    }
+
+    const uintptr_t page = PS5_KERNEL_PAGE_SIZE;
+    const uintptr_t start = (uintptr_t)address & ~(page - 1);
+    const uintptr_t last = (uintptr_t)address + length;
+
+    if (last < (uintptr_t)address || last > UINTPTR_MAX - (page - 1))
+        return false;
+
+    const uintptr_t end = (last + page - 1) & ~(page - 1);
+
+    return sceKernelMprotect(
+        (void*)start, end - start, ps5Protection(access)) == 0;
+}
+
+} // namespace rex::memory
diff --git a/src/core/memory_ps5_alloc.cpp b/src/core/memory_ps5_alloc.cpp
new file mode 100644
index 0000000..bbca6a6
--- /dev/null
+++ b/src/core/memory_ps5_alloc.cpp
@@ -0,0 +1,144 @@
+#include <rex/memory/utils.h>
+#include <ps5platform/shm.h>
+#include <vector>
+#include <mutex>
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+namespace {
+constexpr size_t kPage = 0x4000;
+constexpr size_t kUnit = 0x10000;
+
+struct Reservation {
+    uintptr_t base;
+    size_t bytes;
+};
+
+std::mutex regionMutex;
+std::vector<Reservation> regions;
+
+bool contains(const Reservation& r, void* p, size_t n) {
+    auto addr = reinterpret_cast<uintptr_t>(p);
+    return n && addr >= r.base && n <= r.bytes
+        && addr - r.base <= r.bytes - n;
+}
+
+int protection(rex::memory::PageAccess access) {
+    using rex::memory::PageAccess;
+    switch (access) {
+    case PageAccess::kNoAccess: return 0;
+    case PageAccess::kReadOnly: return PS5_SHM_READ;
+    case PageAccess::kReadWrite: return PS5_SHM_READ | PS5_SHM_WRITE;
+    case PageAccess::kExecuteReadOnly: return PS5_SHM_READ | PS5_SHM_EXEC;
+    case PageAccess::kExecuteReadWrite:
+        return PS5_SHM_READ | PS5_SHM_WRITE | PS5_SHM_EXEC;
+    }
+    return 0;
+}
+}
+
+namespace rex::memory {
+
+void* AllocFixed(void* address, size_t length,
+                 AllocationType type, PageAccess access) {
+    if (!length || length > SIZE_MAX - (kUnit - 1))
+        return nullptr;
+
+    std::lock_guard<std::mutex> lock(regionMutex);
+
+    if (type == AllocationType::kCommit) {
+        if (!address ||
+            reinterpret_cast<uintptr_t>(address) % kPage ||
+            length % kPage)
+            return nullptr;
+
+        auto it = std::find_if(regions.begin(), regions.end(),
+            [&](const Reservation& r) {
+                return contains(r, address, length);
+            });
+
+        if (it == regions.end())
+            return nullptr;
+
+        return ps5_vrange_commit(address, length, protection(access)) == 0
+            ? address : nullptr;
+    }
+
+    if (type != AllocationType::kReserve &&
+        type != AllocationType::kReserveCommit)
+        return nullptr;
+
+    if ((address && reinterpret_cast<uintptr_t>(address) % kUnit) ||
+        (type == AllocationType::kReserveCommit && length % kPage))
+        return nullptr;
+
+    const size_t reservedBytes = (length + kUnit - 1) & ~(kUnit - 1);
+    void* reserved = nullptr;
+    int rc = 0;
+
+    if (address) {
+        rc = ps5_vrange_reserve_at(address, reservedBytes);
+        reserved = address;
+    } else {
+        rc = ps5_vrange_reserve(reservedBytes, nullptr, kUnit, &reserved);
+    }
+
+    if (rc || !reserved)
+        return nullptr;
+
+    if (type == AllocationType::kReserveCommit &&
+        ps5_vrange_commit(reserved, length, protection(access)) != 0) {
+        ps5_vrange_release(reserved, reservedBytes);
+        return nullptr;
+    }
+
+    regions.push_back({reinterpret_cast<uintptr_t>(reserved), reservedBytes});
+    return reserved;
+}
+
+bool DeallocFixed(void* address, size_t length,
+                  DeallocationType type) {
+    if (!address)
+        return false;
+
+    std::lock_guard<std::mutex> lock(regionMutex);
+
+    if (type == DeallocationType::kRelease) {
+        if (length != 0)
+            return false;
+
+        auto it = std::find_if(regions.begin(), regions.end(),
+            [&](const Reservation& r) {
+                return r.base == reinterpret_cast<uintptr_t>(address);
+            });
+
+        if (it == regions.end())
+            return false;
+
+        if (ps5_vrange_release(address, it->bytes) != 0)
+            return false;
+
+        regions.erase(it);
+        return true;
+    }
+
+    if (type == DeallocationType::kDecommit) {
+        if (!length ||
+            reinterpret_cast<uintptr_t>(address) % kPage ||
+            length % kPage)
+            return false;
+
+        auto it = std::find_if(regions.begin(), regions.end(),
+            [&](const Reservation& r) {
+                return contains(r, address, length);
+            });
+
+        return it != regions.end() &&
+            ps5_vrange_decommit(address, length) == 0;
+    }
+
+    return false;
+}
+
+} // namespace rex::memory
diff --git a/src/core/ps5_guest_arena.cpp b/src/core/ps5_guest_arena.cpp
new file mode 100644
index 0000000..ad35bd6
--- /dev/null
+++ b/src/core/ps5_guest_arena.cpp
@@ -0,0 +1,180 @@
+#include <rex/platform/ps5_guest_arena.h>
+#include <algorithm>
+
+namespace rex::memory {
+
+Ps5GuestArena::~Ps5GuestArena() {
+    shutdown();
+}
+
+bool Ps5GuestArena::initialize() {
+    if (base_) return true;
+
+    return ps5_vrange_reserve(
+        kSize,
+        reinterpret_cast<void*>(0x1000000000ULL),
+        kUnit,
+        &base_) == 0;
+}
+
+uint8_t* Ps5GuestArena::address(uint64_t guestAddress) const {
+    if (!base_ || guestAddress >= kSize)
+        return nullptr;
+
+    return static_cast<uint8_t*>(base_) + guestAddress;
+}
+
+
+bool Ps5GuestArena::mapVirtual(uint32_t offset) {
+    if (!base_ || offset % kUnit || offset >= 0x7F000000U)
+        return false;
+
+    for (const auto& unit : units_)
+        if (unit.virtual_mem && unit.offset == offset)
+            return true;
+
+    Unit unit{};
+    unit.offset = offset;
+    unit.virtual_mem = true;
+
+    if (ps5_shm_create(kUnit, &unit.backing) != 0)
+        return false;
+
+    void* view = nullptr;
+    const int rc = ps5_shm_map(
+        &unit.backing, 0, kUnit, address(offset),
+        PS5_SHM_READ | PS5_SHM_WRITE,
+        PS5_SHM_FIXED, &view);
+
+    if (rc != 0) {
+        ps5_shm_destroy(&unit.backing);
+        return false;
+    }
+
+    unit.views[0] = view;
+    units_.push_back(unit);
+    return true;
+}
+
+bool Ps5GuestArena::mapPhysical(uint32_t offset) {
+    return mapUnit(offset, false);
+}
+
+bool Ps5GuestArena::mapXex(uint32_t offset) {
+    return mapUnit(offset, true);
+}
+
+bool Ps5GuestArena::mapUnit(uint32_t offset, bool xex) {
+    if (!base_ || offset % kUnit)
+        return false;
+
+    if (offset >= (xex ? 0x10000000U : 0x20000000U))
+        return false;
+
+    for (const auto& unit : units_)
+        if (!unit.virtual_mem && unit.offset == offset && unit.xex == xex)
+            return true;
+
+    Unit unit{};
+    unit.offset = offset;
+    unit.xex = xex;
+
+    if (ps5_shm_create(kUnit, &unit.backing) != 0)
+        return false;
+
+    const uint64_t targets[5] = {
+        xex ? 0x80000000ULL : 0x100000000ULL,
+        xex ? 0x90000000ULL : 0xA0000000ULL,
+        xex ? 0 : 0xC0000000ULL,
+        xex ? 0 : 0xE0000000ULL,
+        xex ? 0 : 0x7F000000ULL
+    };
+
+    const unsigned count = xex ? 2 :
+        (offset < 0x01000000U ? 5 : 4);
+
+    for (unsigned i = 0; i < count; ++i) {
+        void* target = address(targets[i] + offset);
+
+        int rc = ps5_shm_map(
+            &unit.backing, 0, kUnit, target,
+            PS5_SHM_READ | PS5_SHM_WRITE,
+            PS5_SHM_FIXED, &unit.views[i]);
+
+        if (rc != 0) {
+            releaseUnit(unit);
+            return false;
+        }
+    }
+
+    units_.push_back(unit);
+    return true;
+}
+
+bool Ps5GuestArena::releaseUnit(Unit& unit) {
+    bool ok = true;
+
+    for (auto& view : unit.views) {
+        if (!view) continue;
+
+        if (ps5_shm_unmap(
+                view, kUnit, PS5_SHM_KEEP_RESERVED) == 0)
+            view = nullptr;
+        else
+            ok = false;
+    }
+
+    if (ok)
+        ps5_shm_destroy(&unit.backing);
+
+    return ok;
+}
+
+bool Ps5GuestArena::unmapPhysical(uint32_t offset) {
+    return unmapUnit(offset, false);
+}
+
+bool Ps5GuestArena::unmapXex(uint32_t offset) {
+    return unmapUnit(offset, true);
+}
+
+bool Ps5GuestArena::unmapUnit(uint32_t offset, bool xex) {
+    auto it = std::find_if(
+        units_.begin(), units_.end(),
+        [&](const Unit& u) {
+            return !u.virtual_mem && u.offset == offset && u.xex == xex;
+        });
+
+    if (it == units_.end())
+        return false;
+
+    if (!releaseUnit(*it))
+        return false;
+
+    units_.erase(it);
+    return true;
+}
+
+bool Ps5GuestArena::shutdown() {
+    bool ok = true;
+
+    for (auto& unit : units_)
+        if (!releaseUnit(unit))
+            ok = false;
+
+    if (!ok)
+        return false;
+
+    units_.clear();
+
+    if (base_) {
+        if (ps5_vrange_release(base_, kSize) != 0)
+            return false;
+
+        base_ = nullptr;
+    }
+
+    return true;
+}
+
+}
diff --git a/src/core/threading_ps5.cpp b/src/core/threading_ps5.cpp
